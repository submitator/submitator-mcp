{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/prm"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/prm.js": {
      "maxDuration": 10
    }
  }
}
