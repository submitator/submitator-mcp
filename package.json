{
  "name": "submitator-mcp",
  "version": "0.1.0",
  "description": "Launch your clients' products on up to 100 directories each from Claude Code, Cursor or VS Code.",
  "license": "MIT",
  "type": "module",
  "mcpName": "com.submitator/mcp",
  "bin": {
    "submitator-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/submitator/submitator-mcp.git"
  },
  "homepage": "https://github.com/submitator/submitator-mcp#readme",
  "bugs": {
    "url": "https://github.com/submitator/submitator-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "seo",
    "directory-submission",
    "white-label",
    "agency",
    "backlinks"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "check:pack": "node scripts/clean-room.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:pack"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
